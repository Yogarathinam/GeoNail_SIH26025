# =====================================================================
# GeoNail Monitoring System - Server Environment Configuration
# =====================================================================
# These credentials are used exclusively by the backend API middleware.
# They are NEVER bundled into client-side code or exposed via VITE_ prefixes.

# Brevo (formerly Sendinblue) SMTP Relay Configuration
# Get credentials from: Brevo Dashboard -> Transactional -> Configuration (SMTP & API)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_login_email@domain.com
BREVO_SMTP_KEY=your_brevo_smtp_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email@domain.com

# Optional: Brevo v3 Transactional REST API Key (if prefer REST API over SMTP)
BREVO_API_KEY=
